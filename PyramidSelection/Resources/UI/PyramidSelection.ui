       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="debounceSpinBox">
        <property name="toolTip">
         <string>The patch is recomputed this long after the last handle movement.</string>
        </property>
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>150</number>
        </property>
