     <layout class="QFormLayout" name="footprintFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="widthLabel">
        <property name="text">
         <string>Initial width (mm):</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="widthSpinBox">
        <property name="minimum">
         <double>2.0</double>
        </property>
        <property name="maximum">
         <double>300.0</double>
        </property>
        <property name="value">
         <double>40.0</double>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>width</string>
        </property>
       </widget>
      </item>
