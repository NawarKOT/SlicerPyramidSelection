      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="liveUpdateLabel">
        <property name="text">
         <string>Live patch update:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="liveUpdateCheckBox">
        <property name="toolTip">
         <string>Recompute the patch while the handles are dragged. If unchecked, the patch is hidden during dragging and recomputed after the update delay.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>liveUpdate</string>
        </property>
