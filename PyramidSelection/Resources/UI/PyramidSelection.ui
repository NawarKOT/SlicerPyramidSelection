<ui version="4.0">
 <class>PyramidSelection</class>
 <widget class="qMRMLWidget" name="PyramidSelection">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="ctkCollapsibleButton" name="inputsCollapsibleButton">
     <property name="text">
