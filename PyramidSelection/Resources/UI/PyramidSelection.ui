      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="showSurfaceMeshLabel">
        <property name="text">
         <string>Show surface mesh:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="showSurfaceMeshCheckBox">
        <property name="toolTip">
         <string>Show the surface semi-transparent with its triangle edges, and the patch triangles.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>showSurfaceMesh</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="footprintCollapsibleButton">
     <property name="text">
      <string>Footprint</string>
